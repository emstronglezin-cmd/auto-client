# Copiez ce fichier vers .env localement, ou ajoutez les mêmes variables dans Render.
# DRY_RUN bloque l'envoi Brevo; gardez true jusqu'à validation complète.
NODE_ENV=production
PORT=3000
DRY_RUN=true

# Auth admin: secret aléatoire >= 24 caractères. Ne le partagez jamais.
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-24-chars

# Supabase > Project Settings > Database > Connection string (URI, direct ou pooler).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true

# Groq Console > API Keys. Modèle demandé.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub fine-grained token: accès Contents en écriture au dépôt choisi.
# Le dépôt doit être public, et GitHub Pages configuré depuis la branche GITHUB_BRANCH, / (root).
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=OWNER/REPOSITORY
GITHUB_BRANCH=main
GITHUB_PAGES_BASE_URL=https://OWNER.github.io/REPOSITORY

# Brevo > SMTP & API > API keys.
BREVO_API_KEY=xkeysib-replace_me
SENDER_EMAIL=hello@example.com
SENDER_NAME=Your Web Studio
# Adresse postale réelle, obligatoire dans chaque message commercial.
SENDER_POSTAL_ADDRESS=123 Example Street, City, Postal Code, Country
# Boîte qui reçoit les réponses; le Reply-To des messages prospects est cette adresse.
REPLY_TO_EMAIL=you@example.com
OWNER_EMAIL=you@example.com
# Secret aléatoire pour protéger les webhooks Brevo entrants via ?key=...
BREVO_WEBHOOK_TOKEN=replace-with-another-long-random-secret

# URL publique Render, sans slash final; indispensable aux liens, QStash et webhooks.
PUBLIC_BASE_URL=https://your-service.onrender.com
# Origine GitHub Pages autorisée pour l'interface navigateur (sans chemin /auto-client).
FRONTEND_ORIGIN=https://emstronglezin-cmd.github.io
# Secret indépendant, aléatoire, pour signer les liens de désinscription.
UNSUBSCRIBE_SECRET=replace-with-a-third-long-random-secret

# Upstash Console > QStash > tokens/signing keys.
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_current_replace_me
QSTASH_NEXT_SIGNING_KEY=sig_next_replace_me

# Quotas et pause aléatoire entre les premiers emails (secondes).
MAX_EMAILS_PER_DAY=40
MIN_DELAY_SECONDS=180
MAX_DELAY_SECONDS=2400

# Facultatif: endpoints publics Overpass/Nominatim compatibles.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
